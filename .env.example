# OpenRouter API key — used by Stagehand for DOM reasoning
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Chrome CDP — browser-level WebSocket URL (NOT page-level)
# Get it: curl http://localhost:9222/json/version | jq .webSocketDebuggerUrl
CDP_URL=ws://localhost:9222/devtools/browser/YOUR-BROWSER-GUID

# Stagehand server
STAGEHAND_URL=http://localhost:3100

# Stagehand session model — must support structured output (response_format: json_schema)
# ✅ gpt-4o, gpt-4o-mini | ❌ anthropic/claude-sonnet-4 via OpenRouter
STAGEHAND_SESSION_MODEL=gpt-4o

# Plane
PLANE_URL=http://localhost:3000
PLANE_EMAIL=admin@admin.com
PLANE_PASSWORD=your-password-here
PLANE_WORKSPACE=plane-dev
PLANE_PROJECT=SEED