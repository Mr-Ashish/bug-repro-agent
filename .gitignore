# Per-run artifacts (regenerated, may contain passwords)
reproductions/*/task-prompt.txt
reproductions/*/error.txt
reproductions/*/verdict.md
reproductions/*/action-log.json
reproductions/*/evidence-*.png
reproductions/*/github-comment.md

# Playwright test output (videos, traces, screenshots from replay)
test-results/

# IDE / tool artifacts
.lavish/
.playwright-mcp/
